		{
			"name": "4. Transactions & Double-Entry Ledger",
			"item": [
				{
					"name": "4.1 Money Transfer with Idempotency Key (Alice -> Bob ₹10,000)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate dynamic idempotency key",
									"var uuid = 'idemp-' + Math.random().toString(36).substring(2, 15) + '-' + Date.now();",
									"pm.environment.set('dynamicIdempKey', uuid);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{aliceToken}}"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Idempotency-Key", "value": "{{dynamicIdempKey}}"},
							{"key": "X-Request-ID", "value": "req-trace-transfer-101"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"from_account_id\": 1,\n    \"to_account_id\": 2,\n    \"amount\": 10000.00,\n    \"currency\": \"INR\",\n    \"description\": \"Payment for consulting services\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/transactions/transfer",
							"host": ["{{baseUrl}}"],
							"path": ["transactions", "transfer"]
						}
					}
				},
				{
					"name": "4.2 Idempotency Replay (Same Key - Verifies No Double Debit)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Authorization", "value": "Bearer {{aliceToken}}"},
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Idempotency-Key", "value": "{{dynamicIdempKey}}"},
							{"key": "X-Request-ID", "value": "req-trace-transfer-replay"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"from_account_id\": 1,\n    \"to_account_id\": 2,\n    \"amount\": 10000.00,\n    \"currency\": \"INR\",\n    \"description\": \"Payment for consulting services\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/transactions/transfer",
							"host": ["{{baseUrl}}"],
							"path": ["transactions", "transfer"]
