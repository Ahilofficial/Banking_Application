# Database Configuration (MySQL)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=banking
DB_DSN=root:password@tcp(127.0.0.1:3306)/banking?charset=utf8mb4&parseTime=True&loc=Local

# JWT Configuration
JWT_SECRET=super-secret-banking-jwt-key-2026-production-grade
JWT_ACCESS_EXPIRY=60m
JWT_REFRESH_EXPIRY=168h

# Microservice Endpoints
AUTH_SERVICE_URL=http://localhost:8001
CUSTOMER_SERVICE_URL=http://localhost:8002
ACCOUNT_SERVICE_URL=http://localhost:8003
TRANSACTION_SERVICE_URL=http://localhost:8004
AUDIT_SERVICE_URL=http://localhost:8005
